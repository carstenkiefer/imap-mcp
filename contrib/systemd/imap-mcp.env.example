# Secrets for the imap-mcp service. Install as /etc/imap-mcp/imap-mcp.env
# with owner root:root and mode 0600 – systemd reads it as root.

# Bearer token for the HTTP endpoint (min. 32 characters).
# Generate with: openssl rand -hex 32
# The same value goes into Open WebUI (connection auth "Bearer").
IMAP_MCP_HTTP_TOKEN=

# Mail passwords, one per "passwordEnv" name used in /etc/imap-mcp/config.json
WORK_MAIL_PASSWORD=

# Optional: listen on another interface/port (default 127.0.0.1:8808)
#IMAP_MCP_HTTP_HOST=127.0.0.1
#IMAP_MCP_HTTP_PORT=8808
