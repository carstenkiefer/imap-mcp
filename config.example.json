{
  "accounts": [
    {
      "id": "work",
      "name": "Work mailbox",
      "from": "Jane Doe <jane.doe@example.com>",
      "imap": {
        "host": "imap.example.com",
        "port": 993,
        "secure": true,
        "auth": {
          "user": "jane.doe@example.com",
          "passwordEnv": "WORK_MAIL_PASSWORD"
        }
      },
      "smtp": {
        "host": "smtp.example.com",
        "port": 465,
        "secure": true,
        "auth": {
          "user": "jane.doe@example.com",
          "passwordEnv": "WORK_MAIL_PASSWORD"
        }
      },
      "allowDrafts": true,
      "allowSend": false,
      "allowedRecipients": [
        "*@example.com"
      ],
      "maxRecipients": 10,
      "saveToSent": true,
      "allowForward": true,
      "forwardRecipients": [
        "buha@example.de"
      ],
      "markForwarded": true
    }
  ],
  "security": {
    "urlMode": "defang",
    "maxBodyChars": 20000,
    "approvalMode": "auto",
    "pendingTtlHours": 24
  }
}
